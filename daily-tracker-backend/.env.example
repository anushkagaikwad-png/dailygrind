PORT=3001
FLASK_ENV=development
ADMIN_KEY=GrindPass2026

# --- Database Configurations ---
# Option 1: SQLite fallback (default, if no credentials below are provided)
# No configuration needed, it will create "daily_tracker.db" in the root.

# Option 2: Separate MySQL credentials
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=daily_tracker
# DB_SSL=false

# Option 3: Unified connection string (preferred in production like Railway)
# DATABASE_URL=mysql://user:password@host:port/database
# MYSQL_URL=mysql://user:password@host:port/database
